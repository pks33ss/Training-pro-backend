generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// USERS / GLOBAL
// ============================================

model User {
  id        String     @id @default(cuid())
  email     String?    @unique
  password  String?
  name      String
  lastName  String
  phone     String?
  avatar    String?
  bio       String?
  role      GlobalRole @default(USER)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  username  String?    @unique
  isGhost   Boolean    @default(false)
  deletedAt DateTime?

  emailNotificationsEnabled Boolean @default(true)
  emailOptOut               Boolean @default(false)

  tacticalBackgroundUrlHalf String?
  tacticalBackgroundUrlFull String?
  tacticalBackgroundMode    String  @default("HALF")

  hiddenTabs String[] @default([])

  clubs               ClubMember[]
  refreshTokens       RefreshToken[]
  sessions            Session[]
  calendarEvents      CalendarEvent[]
  calendarInvitations CalendarInvitation[]

  padelSubMatchesAsPlayer1 PadelSubMatch[]   @relation("PadelSubMatchPlayer1")
  padelSubMatchesAsPlayer2 PadelSubMatch[]   @relation("PadelSubMatchPlayer2")
  paymentReminders         PaymentReminder[] @relation("PaymentReminders")

  paymentConceptsCreated PaymentConcept[]    @relation("PaymentConceptCreatedBy")
  paymentAssignments     PaymentAssignment[] @relation("PaymentAssignments")
  payments               Payment[]           @relation("Payments")
  paymentsCreated        Payment[]           @relation("PaymentCreatedBy")

  createdMatches      Match[]
  favoriteTeams       FavoriteTeam[]
  memberships         TeamMembership[]
  pendingInvitations  PendingInvitation[] @relation("InvitationInviter")
  tutorRelationships  TutorRelationship[] @relation("TutorUser")
  playerRelationships TutorRelationship[] @relation("PlayerUser")
  matchStats          MatchPlayerStats[]
  invitedMemberships  TeamMembership[]    @relation("MembershipInviter")
  pendingForMe        PendingInvitation[]

  hostedStreams      LiveStream[]          @relation("HostedStreams")
  liveViewers        LiveViewer[]
  streamPermissions  StreamPermission[]    @relation("UserStreamPermissions")
  grantedPermissions StreamPermission[]    @relation("GrantedBy")
  attendances        Attendance[]
  matchCallups       MatchCallup[]
  matchExclusions    MatchExcludedPlayer[]
  matchViewers MatchViewer[]

  playerProfile PlayerProfile?
  injuries      Injury[]

  libraryExercises LibraryExercise[]

  onCourtIntervals StatSessionOnCourt[] @relation("OnCourtUser")

  createdPlays Play[] @relation("PlayCreatedBy")

  permissionAuditLogs PermissionAuditLog[] @relation("PermissionAuditActor")

  // ── Stats en vivo (Lote 1) ────────────────────────────────
  // Eventos creados / anulados / jugados por este usuario.
  // onDelete: SetNull → si el user se borra físicamente (no debería
  // pasar en JoinSport, que usa soft delete), el evento NO se pierde.
  matchEventsCreated  MatchEvent[] @relation("MatchEventCreator")
  matchEventsVoided   MatchEvent[] @relation("MatchEventVoider")
  matchEventsAsPlayer MatchEvent[] @relation("MatchEventPlayer")

  opponentPlayers OpponentPlayer[] @relation("OpponentPlayerUser")

  statSessionsCreated StatSession[] @relation("StatSessionCreator")

  matchOpponentPlayers MatchOpponentPlayer[] @relation("MatchOpponentPlayerUser")
  teamOpponentPlayers  TeamOpponentPlayer[]  @relation("TeamOpponentPlayerUser")

  @@index([deletedAt])
}

model Club {
  id                      String   @id @default(cuid())
  name                    String
  description             String?
  address                 String?
  phone                   String?
  email                   String?
  logo                    String?
  primaryColor            String?  @default("#00E676")
  secondaryColor          String?  @default("#0A0A0A")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  paymentRemindersEnabled Boolean  @default(true)

  members         ClubMember[]
  teams           Team[]
  calendarEvents  CalendarEvent[]
  paymentConcepts PaymentConcept[]

  roles Role[]

  permissionAuditLogs PermissionAuditLog[] @relation("PermissionAuditClub")
}

model ClubMember {
  id       String   @id @default(cuid())
  userId   String
  clubId   String
  roleId   String
  isActive Boolean  @default(true)
  joinedAt DateTime @default(now())

  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club    Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  roleRef Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, clubId])
  @@index([roleId])
}

model Team {
  id             String   @id @default(cuid())
  name           String
  sport          Sport    @default(BASKETBALL)
  category       String?
  season         String?
  clubId         String
  primaryColor   String?
  secondaryColor String?
  logo           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  sessions               Session[]
  calendarEvents         CalendarEvent[]
  matches                Match[]
  seasons                Season[]
  favoritedBy            FavoriteTeam[]
  memberships            TeamMembership[]
  pendingInvitations     PendingInvitation[]
  statsVisibilityConfigs StatsVisibilityConfig[]
  paymentConcepts        PaymentConcept[]

  plays           Play[]
  statSessions    StatSession[]
  opponentPlayers TeamOpponentPlayer[]
}

model TeamMembership {
  id     String @id @default(cuid())
  userId String
  teamId String

  jerseyNumber Int?
  position     String?
  status       String    @default("ACTIVE")
  seasonId     String?
  joinedAt     DateTime  @default(now())
  leftAt       DateTime?
  invitedById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  season    Season? @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  invitedBy User?   @relation("MembershipInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  roles MembershipRole[]

  @@unique([userId, teamId])
  @@index([userId])
  @@index([teamId])
  @@index([status])
}

model PendingInvitation {
  id          String    @id @default(cuid())
  code        String    @unique
  email       String?
  phone       String?
  userId      String?
  teamId      String
  roleId      String
  channel     String    @default("LINK")
  status      String    @default("PENDING")
  sentAt      DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  invitedById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy User  @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  roleRef   Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([code])
  @@index([email])
  @@index([status])
  @@index([teamId])
  @@index([roleId])
}

model TutorRelationship {
  id                 String   @id @default(cuid())
  tutorUserId        String
  playerUserId       String
  relationship       String
  canPickUp          Boolean  @default(true)
  isEmergencyContact Boolean  @default(false)
  status             String   @default("PENDING")
  requestedById      String
  approvedById       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tutorUser  User @relation("TutorUser", fields: [tutorUserId], references: [id], onDelete: Cascade)
  playerUser User @relation("PlayerUser", fields: [playerUserId], references: [id], onDelete: Cascade)

  @@unique([tutorUserId, playerUserId])
  @@index([tutorUserId])
  @@index([playerUserId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Session {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  duration    Int
  location    String?
  teamId      String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  exercises   Exercise[]
  attendances Attendance[]

  @@index([teamId])
  @@index([date])
}

model Exercise {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String?
  duration    Int?
  difficulty  String?
  sessionId   String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  media   Media[]
}

model Media {
  id          String    @id @default(cuid())
  url         String
  type        MediaType
  title       String?
  description String?
  exerciseId  String
  createdAt   DateTime  @default(now())

  // ✅ NUEVO — JSON de la pizarra (DrawableItem[] serializado) para
  // poder volver a editarla.
  tacticalData Json?

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
}

enum MediaType {
  IMAGE
  VIDEO
  LINK
}

model Attendance {
  id           String           @id @default(cuid())
  userId       String
  sessionId    String
  status       AttendanceStatus @default(PRESENT)
  notes        String?
  registeredAt DateTime         @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId])
  @@index([sessionId])
  @@index([userId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  PENDING
}

model CalendarEvent {
  id          String    @id @default(cuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  type        EventType @default(TRAINING)
  location    String?
  clubId      String
  teamId      String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  club        Club                 @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team        Team?                @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdBy   User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  invitations CalendarInvitation[]

  @@index([clubId])
  @@index([teamId])
  @@index([startDate])
}

model CalendarInvitation {
  id          String           @id @default(cuid())
  eventId     String
  userId      String
  status      InvitationStatus @default(PENDING)
  invitedAt   DateTime         @default(now())
  respondedAt DateTime?

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
}

enum EventType {
  TRAINING
  MATCH
  TOURNAMENT
  MEETING
  OTHER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  MAYBE
}

model MembershipRole {
  id           String   @id @default(cuid())
  membershipId String
  roleId       String
  createdAt    DateTime @default(now())

  membership TeamMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  roleRef    Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([membershipId, roleId])
  @@index([membershipId])
  @@index([roleId])
}

enum GlobalRole {
  SUPER_ADMIN
  USER
}

// ============================================
// ROLES Y PERMISOS
// ============================================

enum RoleScope {
  CLUB
  TEAM
}

model Role {
  id          String    @id @default(cuid())
  clubId      String
  scope       RoleScope
  name        String
  description String?
  isSystem    Boolean   @default(false)
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  club               Club                @relation(fields: [clubId], references: [id], onDelete: Cascade)
  permissions        RolePermission[]
  clubMembers        ClubMember[]
  membershipRoles    MembershipRole[]
  pendingInvitations PendingInvitation[]

  @@unique([clubId, scope, name])
  @@index([clubId, scope])
}

model RolePermission {
  id        String   @id @default(cuid())
  roleId    String
  resource  String
  action    String
  scope     String?
  granted   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action, scope])
  @@index([roleId, resource, action])
}

model PermissionAuditLog {
  id         String   @id @default(cuid())
  clubId     String
  actorId    String
  targetType String
  targetId   String
  action     String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  club  Club @relation("PermissionAuditClub", fields: [clubId], references: [id], onDelete: Cascade)
  actor User @relation("PermissionAuditActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([clubId, createdAt])
  @@index([targetId])
  @@index([actorId])
}

// ============================================
// MATCHES / STREAMING / ETC (sin cambios)
// ============================================

enum MatchType {
  LEAGUE
  FRIENDLY
  CUP
  PLAYOFF
  TOURNAMENT
}

enum MatchLocation {
  HOME
  AWAY
  NEUTRAL
}

enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  FINISHED
  CANCELLED
  POSTPONED
}

model Match {
  id              String        @id @default(cuid())
  date            DateTime
  opponent        String
  location        MatchLocation
  type            MatchType     @default(LEAGUE)
  status          MatchStatus   @default(SCHEDULED)
  venue           String?
  competition     String?
  notes           String?
  subMatchesCount Int?
  setsPerSubMatch Int?
    manualWinner String? // 'TEAM' | 'OPPONENT' | null (para empates en pádel)

  gamePlan String?
  lineup   Json?

  season String?

  teamScore     Int?
  opponentScore Int?

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  callups         MatchCallup[]
  playerStats     MatchPlayerStats[]
  excludedPlayers MatchExcludedPlayer[]

  padelSubMatches PadelSubMatch[]

  liveStream      LiveStream?
  statSessions    StatSession[]
  opponentPlayers MatchOpponentPlayer[]
  viewers MatchViewer[]

  // ── Stats en vivo (Lote 1) ────────────────────────────────
  // true mientras hay una sesión de anotación en vivo abierta.
  // Bloquea la edición manual de MatchPlayerStats (Lote 3).
  liveStatsActive         Boolean   @default(false)
  // Toggle "mostrar al público" de la vista /matches/[id]/live.
  // Solo ADMIN_TEAM / ADMIN_CLUB pueden cambiarlo (Lote 5).
  liveStatsPublicVisible  Boolean   @default(false)
  // Lock blando del anotador: quién tiene la sesión abierta y desde cuándo.
  // Heartbeat en Lote 3; si no late en 30 s, se libera.
  liveStatsLockedByUserId String?
  liveStatsLockedAt       DateTime?

  events MatchEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
  @@index([date])
  @@index([teamId, season])
}

model MatchCallup {
  id      String @id @default(cuid())
  matchId String
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  availableStatus CallupFlagStatus @default(PENDING)
  calledUpStatus  CallupFlagStatus @default(PENDING)
  confirmedStatus CallupFlagStatus @default(PENDING)
  status          CallupStatus     @default(PENDING)

  notes       String?
  respondedAt DateTime?

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, userId])
  @@index([matchId])
  @@index([userId])
}

enum CallupStatus {
  PENDING
  CONFIRMED
  DECLINED
  MAYBE
}

model MatchPlayerStats {
  id            String       @id @default(cuid())
  matchId       String?
  statSessionId String?
  statSession   StatSession? @relation(fields: [statSessionId], references: [id], onDelete: Cascade)
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  minutes     Int?
  seconds     Int?
  points      Int  @default(0)
  rebounds    Int  @default(0)
  reboundsOff Int  @default(0) // ← NUEVO
  reboundsDef Int  @default(0)
  assists     Int  @default(0)
  steals      Int  @default(0)
  blocks      Int  @default(0)
  turnovers   Int  @default(0)
  fouls       Int  @default(0)


 // ── Tiros (convención FIBA: FGM/FGA incluyen los triples) ─────
  // 2P y 3P son la fuente de verdad editables.
  // FGM = 2PM + 3PM y FGA = 2PA + 3PA se recalculan en el backend
  // en cada escritura. PTS = 2*2PM + 3*3PM + FTM también.
  twoPointersMade      Int @default(0)  // ← NUEVO
  twoPointersAttempted Int @default(0)  // ← NUEVO
  fieldGoalsMade         Int @default(0)
  fieldGoalsAttempted    Int @default(0)
  threePointersMade      Int @default(0)
  threePointersAttempted Int @default(0)
  freeThrowsMade         Int @default(0)
  freeThrowsAttempted    Int @default(0)

  blocksAgainst Int  @default(0)
  foulsDrawn    Int  @default(0)
  plusMinus     Int? @default(0)

  match Match? @relation(fields: [matchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, userId])
  @@unique([statSessionId, userId])
  @@index([matchId])
  @@index([userId])
  @@index([statSessionId])
}

model LiveStream {
  id               String    @id @default(cuid())
  matchId          String    @unique
  hostId           String?
  hostPeerId       String?
  isLive           Boolean   @default(false)
  maxUsers         Int       @default(12)
  streamingEnabled Boolean   @default(false)
  startedAt        DateTime?
  endedAt          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  scoreboardEnabled Boolean   @default(false)
  clockEnabled      Boolean   @default(false)
  homeTeamName      String?
  awayTeamName      String?
  homeScore         Int       @default(0)
  awayScore         Int       @default(0)
  clockSeconds      Int       @default(600)
  clockRunning      Boolean   @default(false)
  clockDirection    String    @default("DOWN")
  clockStartedAt    DateTime?
  clockDuration     Int       @default(600)
  currentPeriod     Int       @default(1)
  isOvertime        Boolean   @default(false)
  quarterDuration   Int       @default(600)
  overtimeDuration  Int       @default(300)
  customPeriodLabel String?

  match       Match              @relation(fields: [matchId], references: [id], onDelete: Cascade)
  host        User?              @relation("HostedStreams", fields: [hostId], references: [id], onDelete: SetNull)
  viewers     LiveViewer[]
  permissions StreamPermission[]

  @@index([matchId])
  @@index([hostId])
}

model LiveViewer {
  id           String   @id @default(cuid())
  liveStreamId String
  userId       String
  peerId       String
  joinedAt     DateTime @default(now())

  liveStream LiveStream @relation(fields: [liveStreamId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([liveStreamId, userId])
  @@index([liveStreamId])
}

model StreamPermission {
  id           String   @id @default(cuid())
  liveStreamId String
  userId       String
  canStream    Boolean  @default(false)
  grantedById  String?
  grantedAt    DateTime @default(now())

  liveStream LiveStream @relation(fields: [liveStreamId], references: [id], onDelete: Cascade)
  user       User       @relation("UserStreamPermissions", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy  User?      @relation("GrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([liveStreamId, userId])
  @@index([liveStreamId])
  @@index([userId])
}

model Season {
  id          String        @id @default(cuid())
  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  color       String?
  teamId      String
  team        Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  blocks      SeasonBlock[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  memberships TeamMembership[]

  @@index([teamId])
}

model SeasonBlock {
  id          String    @id @default(cuid())
  name        String
  description String?
  color       String?
  order       Int       @default(0)
  startDate   DateTime?
  endDate     DateTime?

  parentId String?
  parent   SeasonBlock?  @relation("BlockHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children SeasonBlock[] @relation("BlockHierarchy")

  seasonId String
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  sections SeasonSection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([seasonId])
  @@index([parentId])
  @@index([seasonId, parentId, order])
}

model SeasonSection {
  id          String    @id @default(cuid())
  name        String
  description String?
  color       String?
  order       Int       @default(0)
  startDate   DateTime?
  endDate     DateTime?

  blockId String
  block   SeasonBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([blockId])
  @@index([blockId, order])
}

model FavoriteTeam {
  id        String   @id @default(cuid())
  userId    String
  teamId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([userId])
  @@index([teamId])
}

enum Sport {
  BASKETBALL
  PADEL
  FOOTBALL
  HANDBALL
  VOLLEYBALL
  TENNIS
}

enum CallupFlagStatus {
  PENDING
  YES
  NO
}

model PadelSubMatch {
  id        String   @id @default(cuid())
  matchId   String
  order     Int
  player1Id String?
  player2Id String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  match   Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player1 User?      @relation("PadelSubMatchPlayer1", fields: [player1Id], references: [id], onDelete: SetNull)
  player2 User?      @relation("PadelSubMatchPlayer2", fields: [player2Id], references: [id], onDelete: SetNull)
  sets    PadelSet[]

  @@unique([matchId, order])
  @@index([matchId])
}

model PadelSet {
  id         String   @id @default(cuid())
  subMatchId String
  order      Int
  homeScore  Int      @default(0)
  awayScore  Int      @default(0)
  played     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  subMatch PadelSubMatch @relation(fields: [subMatchId], references: [id], onDelete: Cascade)

  @@unique([subMatchId, order])
  @@index([subMatchId])
}

enum StatsScope {
  MATCH
  TEAM
  PLAYER
}

enum StatsAudienceRole {
  PLAYER
  COACH
  ASSISTANT
  ADMIN_TEAM
  VISITOR
}

model StatsVisibilityConfig {
  id        String            @id @default(cuid())
  teamId    String
  team      Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sport     Sport
  scope     StatsScope
  role      StatsAudienceRole
  metricKey String
  visible   Boolean           @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, scope, role, metricKey])
  @@index([teamId, scope, role])
  @@index([teamId, scope])
}

model PlayerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  birthDate       DateTime?
  dni             String?
  fatherName      String?
  motherName      String?
  fatherPhone     String?
