generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(cuid())
  email     String?    @unique
  password  String?
  name      String
  lastName  String
  phone     String? // ✅ NUEVO
  avatar    String? // ✅ NUEVO (URL de Cloudinary)
  bio       String? // ✅ NUEVO
  role      GlobalRole @default(USER)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  username  String?    @unique
  isGhost   Boolean    @default(false)
  deletedAt DateTime?

  clubs               ClubMember[]
  refreshTokens       RefreshToken[]
  sessions            Session[]
  calendarEvents      CalendarEvent[]
  calendarInvitations CalendarInvitation[]

  padelSubMatchesAsPlayer1 PadelSubMatch[] @relation("PadelSubMatchPlayer1") // ✅ NUEVA
  padelSubMatchesAsPlayer2 PadelSubMatch[] @relation("PadelSubMatchPlayer2") // ✅ NUEVA

  createdMatches      Match[] // ✅ NUEVO
  favoriteTeams       FavoriteTeam[]
  memberships         TeamMembership[]
  pendingInvitations  PendingInvitation[] @relation("InvitationInviter")
  tutorRelationships  TutorRelationship[] @relation("TutorUser")
  playerRelationships TutorRelationship[] @relation("PlayerUser")
  matchStats          MatchPlayerStats[]
  invitedMemberships  TeamMembership[]    @relation("MembershipInviter")
  pendingForMe        PendingInvitation[]

  hostedStreams      LiveStream[]       @relation("HostedStreams")
  liveViewers        LiveViewer[]
  streamPermissions  StreamPermission[] @relation("UserStreamPermissions")
  grantedPermissions StreamPermission[] @relation("GrantedBy")
  attendances        Attendance[]
  matchCallups       MatchCallup[]

  playerProfile PlayerProfile?
  injuries      Injury[]

  // ✅ NUEVO — Biblioteca de ejercicios del usuario
  libraryExercises LibraryExercise[]

  // ✅ NUEVO — Jugadas (Playbook) creadas por el usuario
  createdPlays Play[] @relation("PlayCreatedBy")

  @@index([deletedAt])
}

model Club {
  id             String   @id @default(cuid())
  name           String
  description    String?
  address        String?
  phone          String?
  email          String?
  logo           String?
  primaryColor   String?  @default("#00E676")
  secondaryColor String?  @default("#0A0A0A")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  members        ClubMember[]
  teams          Team[]
  calendarEvents CalendarEvent[]
}

model ClubMember {
  id       String   @id @default(cuid())
  userId   String
  clubId   String
  role     ClubRole @default(COACH)
  isActive Boolean  @default(true)
  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([userId, clubId])
}

model Team {
  id             String   @id @default(cuid())
  name           String
  sport          Sport    @default(BASKETBALL)
  category       String?
  season         String?
  clubId         String
  primaryColor   String?
  secondaryColor String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  sessions               Session[]
  calendarEvents         CalendarEvent[]
  matches                Match[]
  seasons                Season[]
  favoritedBy            FavoriteTeam[]
  memberships            TeamMembership[]
  pendingInvitations     PendingInvitation[]
  statsVisibilityConfigs StatsVisibilityConfig[]

  // ✅ NUEVO — Jugadas del equipo (Playbook)
  plays Play[]
}

model TeamMembership {
  id     String @id @default(cuid())
  userId String
  teamId String

  jerseyNumber Int?
  position     String?
  status       String    @default("ACTIVE")
  seasonId     String?
  joinedAt     DateTime  @default(now())
  leftAt       DateTime?
  invitedById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  season    Season? @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  invitedBy User?   @relation("MembershipInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  roles MembershipRole[]

  @@unique([userId, teamId])
  @@index([userId])
  @@index([teamId])
  @@index([status])
}

model PendingInvitation {
  id          String             @id @default(cuid())
  code        String             @unique
  email       String?
  phone       String?
  userId      String?
  teamId      String
  role        MembershipRoleType @default(PLAYER)
  channel     String             @default("LINK")
  status      String             @default("PENDING")
  sentAt      DateTime           @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  invitedById String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user      User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy User  @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([email])
  @@index([status])
  @@index([teamId])
}

model TutorRelationship {
  id                 String   @id @default(cuid())
  tutorUserId        String
  playerUserId       String
  relationship       String
  canPickUp          Boolean  @default(true)
  isEmergencyContact Boolean  @default(false)
  status             String   @default("PENDING")
  requestedById      String
  approvedById       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tutorUser  User @relation("TutorUser", fields: [tutorUserId], references: [id], onDelete: Cascade)
  playerUser User @relation("PlayerUser", fields: [playerUserId], references: [id], onDelete: Cascade)

  @@unique([tutorUserId, playerUserId])
  @@index([tutorUserId])
  @@index([playerUserId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Session {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  duration    Int
  location    String?
  teamId      String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  exercises   Exercise[]
  attendances Attendance[]

  @@index([teamId])
  @@index([date])
}

model Exercise {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String?
  duration    Int?
  difficulty  String?
  sessionId   String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  media   Media[]
}

model Media {
  id          String    @id @default(cuid())
  url         String
  type        MediaType
  title       String?
  description String?
  exerciseId  String
  createdAt   DateTime  @default(now())

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
}

enum MediaType {
  IMAGE
  VIDEO
  LINK
}

model Attendance {
  id           String           @id @default(cuid())
  userId       String
  sessionId    String
  status       AttendanceStatus @default(PRESENT)
  notes        String?
  registeredAt DateTime         @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId])
  @@index([sessionId])
  @@index([userId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  PENDING
}

model CalendarEvent {
  id          String    @id @default(cuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  type        EventType @default(TRAINING)
  location    String?
  clubId      String
  teamId      String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  club        Club                 @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team        Team?                @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdBy   User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  invitations CalendarInvitation[]

  @@index([clubId])
  @@index([teamId])
  @@index([startDate])
}

model CalendarInvitation {
  id          String           @id @default(cuid())
  eventId     String
  userId      String
  status      InvitationStatus @default(PENDING)
  invitedAt   DateTime         @default(now())
  respondedAt DateTime?

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
}

enum EventType {
  TRAINING
  MATCH
  TOURNAMENT
  MEETING
  OTHER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  MAYBE
}

enum ClubRole {
  ADMIN_CLUB
  COACH
  ASSISTANT
  MEMBER
}

enum MembershipRoleType {
  PLAYER
  COACH
  ASSISTANT
  ADMIN_TEAM
  VISITOR
}

model MembershipRole {
  id           String             @id @default(cuid())
  membershipId String
  role         MembershipRoleType
  createdAt    DateTime           @default(now())

  membership TeamMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, role])
  @@index([membershipId])
  @@index([role])
}

enum GlobalRole {
  SUPER_ADMIN
  USER
}

// ============================================
// PARTIDOS
// ============================================

enum MatchType {
  LEAGUE
  FRIENDLY
  CUP
  PLAYOFF
  TOURNAMENT
}

enum MatchLocation {
  HOME
  AWAY
  NEUTRAL
}

enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  FINISHED
  CANCELLED
  POSTPONED
}

model Match {
  id              String        @id @default(cuid())
  date            DateTime
  opponent        String
  location        MatchLocation
  type            MatchType     @default(LEAGUE)
  status          MatchStatus   @default(SCHEDULED)
  venue           String?
  competition     String?
  notes           String?
  subMatchesCount Int?
  setsPerSubMatch Int?

  gamePlan String?
  lineup   Json?

  season String?

  teamScore     Int?
  opponentScore Int?

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  callups     MatchCallup[]
  playerStats MatchPlayerStats[]

  padelSubMatches PadelSubMatch[]

  liveStream LiveStream?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
  @@index([date])
  @@index([teamId, season])
}

model MatchCallup {
  id      String @id @default(cuid())
  matchId String
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  availableStatus CallupFlagStatus @default(PENDING)
  calledUpStatus  CallupFlagStatus @default(PENDING)
  confirmedStatus CallupFlagStatus @default(PENDING)
  status          CallupStatus     @default(PENDING)

  notes       String?
  respondedAt DateTime?

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, userId])
  @@index([matchId])
  @@index([userId])
}

enum CallupStatus {
  PENDING
  CONFIRMED
  DECLINED
  MAYBE
}

model MatchPlayerStats {
  id      String @id @default(cuid())
  matchId String
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  minutes   Int?
  points    Int  @default(0)
  rebounds  Int  @default(0)
  assists   Int  @default(0)
  steals    Int  @default(0)
  blocks    Int  @default(0)
  turnovers Int  @default(0)
  fouls     Int  @default(0)

  fieldGoalsMade         Int @default(0)
  fieldGoalsAttempted    Int @default(0)
  threePointersMade      Int @default(0)
  threePointersAttempted Int @default(0)
  freeThrowsMade         Int @default(0)
  freeThrowsAttempted    Int @default(0)

  blocksAgainst Int  @default(0)
  foulsDrawn    Int  @default(0)
  plusMinus     Int? @default(0)

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, userId])
  @@index([matchId])
  @@index([userId])
}

// ============================================
// LIVE STREAMING
// ============================================

model LiveStream {
  id               String    @id @default(cuid())
  matchId          String    @unique
  hostId           String?
  hostPeerId       String?
  isLive           Boolean   @default(false)
  maxUsers         Int       @default(12)
  streamingEnabled Boolean   @default(false)
  startedAt        DateTime?
  endedAt          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  scoreboardEnabled Boolean   @default(false)
  clockEnabled      Boolean   @default(false)
  homeTeamName      String?
  awayTeamName      String?
  homeScore         Int       @default(0)
  awayScore         Int       @default(0)
  clockSeconds      Int       @default(600)
  clockRunning      Boolean   @default(false)
  clockDirection    String    @default("DOWN")
  clockStartedAt    DateTime?
  clockDuration     Int       @default(600)
  currentPeriod     Int       @default(1)
  isOvertime        Boolean   @default(false)
  quarterDuration   Int       @default(600)
  overtimeDuration  Int       @default(300)
  customPeriodLabel String?

  match       Match              @relation(fields: [matchId], references: [id], onDelete: Cascade)
  host        User?              @relation("HostedStreams", fields: [hostId], references: [id], onDelete: SetNull)
  viewers     LiveViewer[]
  permissions StreamPermission[]

  @@index([matchId])
  @@index([hostId])
}

model LiveViewer {
  id           String   @id @default(cuid())
  liveStreamId String
  userId       String
  peerId       String
  joinedAt     DateTime @default(now())

  liveStream LiveStream @relation(fields: [liveStreamId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([liveStreamId, userId])
  @@index([liveStreamId])
}

model StreamPermission {
  id           String   @id @default(cuid())
  liveStreamId String
  userId       String
  canStream    Boolean  @default(false)
  grantedById  String?
  grantedAt    DateTime @default(now())

  liveStream LiveStream @relation(fields: [liveStreamId], references: [id], onDelete: Cascade)
  user       User       @relation("UserStreamPermissions", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy  User?      @relation("GrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([liveStreamId, userId])
  @@index([liveStreamId])
  @@index([userId])
}

// ============================================
// PLANIFICACIÓN DE TEMPORADA
// ============================================

model Season {
  id          String        @id @default(cuid())
  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  color       String?
  teamId      String
  team        Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  blocks      SeasonBlock[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  memberships TeamMembership[]

  @@index([teamId])
}

model SeasonBlock {
  id          String    @id @default(cuid())
  name        String
  description String?
  color       String?
  order       Int       @default(0)
  startDate   DateTime?
  endDate     DateTime?

  parentId String?
  parent   SeasonBlock?  @relation("BlockHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children SeasonBlock[] @relation("BlockHierarchy")

  seasonId String
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  sections SeasonSection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([seasonId])
  @@index([parentId])
  @@index([seasonId, parentId, order])
}

model SeasonSection {
  id          String    @id @default(cuid())
  name        String
  description String?
  color       String?
  order       Int       @default(0)
  startDate   DateTime?
  endDate     DateTime?

  blockId String
  block   SeasonBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([blockId])
  @@index([blockId, order])
}

model FavoriteTeam {
  id        String   @id @default(cuid())
  userId    String
  teamId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([userId])
  @@index([teamId])
}

enum Sport {
  BASKETBALL
  PADEL
  FOOTBALL
  HANDBALL
  VOLLEYBALL
  TENNIS
}

enum CallupFlagStatus {
  PENDING
  YES
  NO
}

// ============================================
// PÁDEL — SUBPARTIDOS
// ============================================

model PadelSubMatch {
  id        String   @id @default(cuid())
  matchId   String
  order     Int
  player1Id String?
  player2Id String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  match   Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player1 User?      @relation("PadelSubMatchPlayer1", fields: [player1Id], references: [id], onDelete: SetNull)
  player2 User?      @relation("PadelSubMatchPlayer2", fields: [player2Id], references: [id], onDelete: SetNull)
  sets    PadelSet[]

  @@unique([matchId, order])
  @@index([matchId])
}

model PadelSet {
  id         String   @id @default(cuid())
  subMatchId String
  order      Int
  homeScore  Int      @default(0)
  awayScore  Int      @default(0)
  played     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  subMatch PadelSubMatch @relation(fields: [subMatchId], references: [id], onDelete: Cascade)

  @@unique([subMatchId, order])
  @@index([subMatchId])
}

// ============================================
// CONFIGURACIÓN DE VISIBILIDAD DE ESTADÍSTICAS
// ============================================

enum StatsScope {
  MATCH
  TEAM
  PLAYER
}

enum StatsAudienceRole {
  PLAYER
  COACH
  ASSISTANT
  ADMIN_TEAM
  VISITOR
}

model StatsVisibilityConfig {
  id        String            @id @default(cuid())
  teamId    String
  team      Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sport     Sport
  scope     StatsScope
  role      StatsAudienceRole
  metricKey String
  visible   Boolean           @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, scope, role, metricKey])
  @@index([teamId, scope, role])
  @@index([teamId, scope])
}

// ============================================
// PERFIL DEL JUGADOR
// ============================================

model PlayerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  birthDate       DateTime?
  dni             String?
  fatherName      String?
  motherName      String?
  fatherPhone     String?
  motherPhone     String?
  address         String?
  schoolOrCompany String?
  allergies       String?

  height   Int?
  wingspan Int?
  weight   Int?

  emergencyContactName  String?
  emergencyContactPhone String?

  medicalInsurance       String?
  medicalInsuranceNumber String?

  shirtSize String?
  pantsSize String?
  shoeSize  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ============================================
// HISTORIAL DE LESIONES
// ============================================

enum InjuryStatus {
  ACTIVE
  RECOVERED
  CHRONIC
}

model Injury {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date        DateTime
  description String
  bodyPart    String?
  severity    String?
  status      InjuryStatus @default(ACTIVE)

  expectedReturn DateTime?
  actualReturn   DateTime?
  treatment      String?
  doctor         String?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// ============================================
// BIBLIOTECA DE EJERCICIOS (por usuario)
// ============================================

model LibraryExercise {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  name        String
  description String?
  category    String?
  tags        String[] @default([])
  duration    Int?
  difficulty  String?

  media LibraryMedia[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([ownerId, category])
  @@index([ownerId, createdAt])
}

model LibraryMedia {
  id                String    @id @default(cuid())
  url               String
  type              MediaType
  title             String?
  description       String?
  libraryExerciseId String
  createdAt         DateTime  @default(now())

  libraryExercise LibraryExercise @relation(fields: [libraryExerciseId], references: [id], onDelete: Cascade)

  @@index([libraryExerciseId])
}

// ============================================
// PLAYBOOK — JUGADAS POR EQUIPO
// ============================================

model Play {
  id          String  @id @default(cuid())
  name        String
  description String?

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("PlayCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  steps PlayStep[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
  @@index([teamId, createdAt])
}

model PlayStep {
  id     String @id @default(cuid())
  playId String
  play   Play   @relation(fields: [playId], references: [id], onDelete: Cascade)

  order       Int     @default(0)
  description String?
  imageUrl    String? // data URL (base64) de la pizarra o imagen subida

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([playId, order])
}
